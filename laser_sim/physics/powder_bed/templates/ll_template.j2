# LIGGGHTS-PUBLIC input deck — laser_sim auto-generated
# Powder deposition into a thin layer for LPBF DEM packing.
# scenario layer = {{ layer_um }} um, ROI = {{ roi }} mm

atom_style      sphere
boundary        p p f
newton          off
units           si
processors      * * 1

region          box block {{ x0_m }} {{ x1_m }} {{ y0_m }} {{ y1_m }} 0.0 {{ z_top_m }} units box
create_box      1 box

neighbor        {{ neighbor_skin_m }} bin
neigh_modify    delay 0

# inter-particle Hertzian contact
fix             m1 all property/global youngsModulus peratomtype 7.0e10
fix             m2 all property/global poissonsRatio peratomtype 0.3
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.3

pair_style      gran model hertz tangential history
pair_coeff      * *

# log-normal PSD around d50 = {{ d50_um }} um  (d10={{ d10_um }}, d90={{ d90_um }})
fix             pts1 all particletemplate/sphere 49979 atom_type 1 \
                density constant {{ rho_solid }} radius gaussian number \
                {{ r50_m }} {{ r_sigma_m }}
fix             pdd  all particledistribution/discrete 49981 1 pts1 1.0

# rain particles in from the top
region          rain block {{ x0_m }} {{ x1_m }} {{ y0_m }} {{ y1_m }} \
                {{ z_top_m_minus_rain }} {{ z_top_m }} units box
fix             ins all insert/rate/region seed {{ seed }} distributiontemplate pdd \
                nparticles {{ n_target }} particlerate {{ insert_rate }} \
                insert_every 1000 overlapcheck yes region rain

fix             grav all gravity 9.81 vector 0 0 -1
fix             integ all nve/sphere

dump            d1 all custom/vtk {{ dump_every }} dump/p_*.vtk id x y z radius

timestep        {{ dt }}
run             {{ n_steps }}
